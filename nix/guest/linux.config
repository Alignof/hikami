# Applied on top of `make ARCH=riscv defconfig`.

# No modules: everything needed is built in.
# CONFIG_MODULES is not set

# Keep vmlinux small; it is embedded in the hikami binary.
# CONFIG_DEBUG_INFO is not set
CONFIG_DEBUG_INFO_NONE=y

# Root filesystem on the AHCI SATA disk emulated by hikami.
CONFIG_PCI=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_BLK_DEV_SD=y
CONFIG_EXT4_FS=y

CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Console and power-off through SBI.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_RISCV_SBI_V01=y

# The guest runs in VS-mode: KVM would probe H-extension CSRs (e.g. hgatp)
# that hikami does not emulate.
# CONFIG_VIRTUALIZATION is not set
# CONFIG_KVM is not set
